# Production-only:
# DIRECT_DATABASE_URL=   (Neon direct, non-pooled URL used for migrations)
# ALLOW_MOCK_IRP=        (never set in production unless deliberately testing)

# Optional AI assistant (open-source model through any OpenAI-compatible host). See docs/keys.md for links.
# Without these the app still works; Smart entry and New order use simple matching.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Optional voice input (speech-to-text). Without these the Speak button is hidden.
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
