generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  WORKER
}

enum ActorType {
  HUMAN
  AGENT
}

enum OrderSource {
  MANUAL
  TEXT
  VOICE
  IMAGE
}

enum StockLedgerType {
  OPENING
  PRODUCED
  BILLED
  RETURN
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model User {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("users")
}

model BusinessProfile {
  id                   String   @id @default("default")
  legalName            String
  tradeName            String?
  gstin                String
  stateCode            String
  addressLine1         String
  addressLine2         String?
  city                 String
  pincode              String
  phone                String
  email                String?
  upiId                String?
  bankDetails          String?
  invoiceTerms         String?
  einvoicingApplicable Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("business_profile")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  gstin          String?  @unique
  billingAddress String
  stateCode      String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bills          Bill[]
  orders         Order[]

  @@index([name])
  @@map("customers")
}

model Product {
  id                 String             @id @default(cuid())
  sku                String?            @unique
  name               String
  unit               String             @default("pcs")
  qtyPerCarton       Int                @default(1)
  hsnCode            String
  unitPrice          Decimal            @db.Decimal(12, 2)
  gstRate            Decimal            @db.Decimal(5, 2)
  reorderLevel       Decimal            @default(0) @db.Decimal(12, 2)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  stockLedgerEntries StockLedgerEntry[]
  stockCounts        StockCount[]
  billLineItems      BillLineItem[]
  orderLines         OrderLine[]

  @@index([name])
  @@map("products")
}

model StockLedgerEntry {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  quantityDelta   Decimal         @db.Decimal(12, 2)
  type            StockLedgerType
  reason          String?
  sourceReference String?
  createdBy       String
  actorType       ActorType       @default(HUMAN)
  sourceMetadata  Json?
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_ledger")
}

model NumberSeries {
  series        String // "INVOICE" | "CREDIT_NOTE"
  financialYear String // "2026-27"
  prefix        String
  nextSerial    Int      @default(1)
  createdAt     DateTime @default(now())

  @@id([series, financialYear])
  @@map("number_series")
}

model Bill {
  id                String            @id @default(cuid())
  invoiceNumber     String            @unique
  financialYear     String
  billDate          DateTime          @default(now())
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerName      String
  customerGstin     String?
  customerAddress   String
  customerStateCode String
  customerPhone     String?
  supplierLegalName String
  supplierGstin     String
  supplierAddress   String
  supplierStateCode String
  placeOfSupply     String
  deliveryAddress   String            @default("")
  reverseCharge     Boolean           @default(false)
  grossTotal        Decimal           @db.Decimal(12, 2)
  discountTotal     Decimal           @db.Decimal(12, 2)
  taxableTotal      Decimal           @db.Decimal(12, 2)
  cgstTotal         Decimal           @db.Decimal(12, 2)
  sgstTotal         Decimal           @db.Decimal(12, 2)
  igstTotal         Decimal           @db.Decimal(12, 2)
  taxTotal          Decimal           @db.Decimal(12, 2)
  roundOff          Decimal           @db.Decimal(12, 2)
  grandTotal        Decimal           @db.Decimal(12, 2)
  notes             String?
  createdBy         String
  actorType         ActorType         @default(HUMAN)
  sourceMetadata    Json?
  idempotencyKey    String            @unique
  createdAt         DateTime          @default(now())
  lineItems         BillLineItem[]
  charges           BillCharge[]
  orderId           String?
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments          PaymentLogEntry[]
  creditNotes       CreditNote[]
  irpSubmission     IrpSubmission?

  @@index([customerId])
  @@index([orderId])
  @@index([billDate])
  @@map("bills")
}

model BillLineItem {
  id                String           @id @default(cuid())
  billId            String
  bill              Bill             @relation(fields: [billId], references: [id])
  lineNo            Int
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  productName       String
  productSku        String?
  hsnCode           String
  unit              String
  qtyPerCarton      Int              @default(1)
  quantity          Decimal          @db.Decimal(12, 2)
  unitPrice         Decimal          @db.Decimal(12, 2)
  discountAmount    Decimal          @default(0) @db.Decimal(12, 2)
  taxableValue      Decimal          @db.Decimal(12, 2)
  gstRate           Decimal          @db.Decimal(5, 2)
  cgstAmount        Decimal          @db.Decimal(12, 2)
  sgstAmount        Decimal          @db.Decimal(12, 2)
  igstAmount        Decimal          @db.Decimal(12, 2)
  lineTotal         Decimal          @db.Decimal(12, 2)
  shortfallQuantity Decimal?         @db.Decimal(12, 2)
  creditNoteLines   CreditNoteLine[]

  @@unique([billId, lineNo])
  @@index([productId])
  @@map("bill_line_items")
}

/// Extra charges on an invoice: carton packing, crate, freight (immutable, like the bill itself).
model BillCharge {
  id           String  @id @default(cuid())
  billId       String
  bill         Bill    @relation(fields: [billId], references: [id])
  chargeNo     Int
  kind         String // CARTON | CRATE | FREIGHT | OTHER
  label        String
  taxableValue Decimal @db.Decimal(12, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgstAmount   Decimal @db.Decimal(12, 2)
  sgstAmount   Decimal @db.Decimal(12, 2)
  igstAmount   Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  @@unique([billId, chargeNo])
  @@map("bill_charges")
}

model PaymentLogEntry {
  id             String        @id @default(cuid())
  billId         String
  bill           Bill          @relation(fields: [billId], references: [id])
  amount         Decimal       @db.Decimal(12, 2) // negative = refund
  method         PaymentMethod
  reference      String?
  note           String?
  paidAt         DateTime      @default(now())
  recordedBy     String
  actorType      ActorType     @default(HUMAN)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([billId])
  @@map("payment_log")
}

model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String           @unique
  financialYear    String
  noteDate         DateTime         @default(now())
  billId           String
  bill             Bill             @relation(fields: [billId], references: [id])
  reason           String
  restock          Boolean
  taxableTotal     Decimal          @db.Decimal(12, 2)
  cgstTotal        Decimal          @db.Decimal(12, 2)
  sgstTotal        Decimal          @db.Decimal(12, 2)
  igstTotal        Decimal          @db.Decimal(12, 2)
  taxTotal         Decimal          @db.Decimal(12, 2)
  roundOff         Decimal          @db.Decimal(12, 2)
  grandTotal       Decimal          @db.Decimal(12, 2)
  createdBy        String
  actorType        ActorType        @default(HUMAN)
  idempotencyKey   String           @unique
  createdAt        DateTime         @default(now())
  lines            CreditNoteLine[]
  irpSubmission    IrpSubmission?

  @@index([billId])
  @@index([noteDate])
  @@map("credit_notes")
}

model CreditNoteLine {
  id             String       @id @default(cuid())
  creditNoteId   String
  creditNote     CreditNote   @relation(fields: [creditNoteId], references: [id])
  billLineItemId String
  billLineItem   BillLineItem @relation(fields: [billLineItemId], references: [id])
  productId      String
  quantity       Decimal      @db.Decimal(12, 2)
  taxableValue   Decimal      @db.Decimal(12, 2)
  cgstAmount     Decimal      @db.Decimal(12, 2)
  sgstAmount     Decimal      @db.Decimal(12, 2)
  igstAmount     Decimal      @db.Decimal(12, 2)
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@index([billLineItemId])
  @@index([creditNoteId])
  @@map("credit_note_lines")
}

model StockCount {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  countedQuantity  Decimal   @db.Decimal(12, 2)
  expectedQuantity Decimal   @db.Decimal(12, 2)
  note             String?
  countedBy        String
  countedAt        DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  appliedDelta     Decimal?  @db.Decimal(12, 2)
  discardedBy      String?
  discardedAt      DateTime?
  actorType        ActorType @default(HUMAN)
  sourceMetadata   Json?

  @@index([productId])
  @@map("stock_counts")
}

model IrpSubmission {
  id            String      @id @default(cuid())
  documentType  String // "INVOICE" | "CREDIT_NOTE"
  billId        String?     @unique
  bill          Bill?       @relation(fields: [billId], references: [id])
  creditNoteId  String?     @unique
  creditNote    CreditNote? @relation(fields: [creditNoteId], references: [id])
  status        String      @default("PENDING") // PENDING | SUBMITTING | ACCEPTED | REJECTED | FAILED
  attemptCount  Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  irn           String?
  ackNumber     String?
  ackDate       DateTime?
  signedQrCode  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@map("irp_submissions")
}

/// A customer's request for goods due on a date. Lines never change; an order is cancelled or closed instead.
/// How much has been delivered is worked out from the bills raised against the order, so it can never drift.
model Order {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  dueDate        DateTime    @db.Date
  notes          String?
  source         OrderSource @default(MANUAL)
  sourceText     String?
  cancelledAt    DateTime?
  closedAt       DateTime?
  createdBy      String
  actorType      ActorType   @default(HUMAN)
  sourceMetadata Json?
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  lines          OrderLine[]
  bills          Bill[]

  @@index([customerId])
  @@index([dueDate])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  lineNo    Int
  productId String
  product   Product @relation(fields: [productId], references: [id])
  /// Ordered quantity in pieces (cartons are worked out with the item's carton size).
  quantity  Decimal @db.Decimal(12, 2)

  @@unique([orderId, lineNo])
  @@index([productId])
  @@map("order_lines")
}
